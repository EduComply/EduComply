{
  "name": "educomply",
  "version": "0.1.0",
  "private": true,
  "description": "Institutional video training and interactive assessment platform",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:db": "npm run test:db -w backend",
    "test:redis": "npm run test:redis -w backend",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "npm run db:generate -w backend",
    "db:validate": "npm run db:validate -w backend",
    "db:status": "npm run db:status -w backend",
    "db:migrate:deploy": "npm run db:migrate:deploy -w backend",
    "db:migrate:create": "npm run db:migrate:create -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:inspect": "npm run db:inspect -w backend",
    "db:grant-role": "npm run db:grant-role -w backend --",
    "db:studio": "npm run db:studio -w backend",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "redis:status": "docker compose ps redis"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
