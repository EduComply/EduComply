{
  "name": "educomply",
  "version": "0.1.0",
  "private": true,
  "description": "Institutional video training and interactive assessment platform",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "tsx tools/dev/cli.ts dev",
    "dev:backend": "tsx tools/dev/cli.ts dev --only backend",
    "dev:frontend": "tsx tools/dev/cli.ts dev --only frontend",
    "dev:doctor": "tsx tools/dev/cli.ts doctor",
    "dev:deps": "tsx tools/dev/cli.ts deps-up",
    "dev:deps:stop": "tsx tools/dev/cli.ts deps-stop",
    "dev:stop": "tsx tools/dev/cli.ts stop",
    "dev:health": "tsx tools/dev/cli.ts health",
    "docker:up": "tsx tools/dev/cli.ts docker-up",
    "docker:stop": "tsx tools/dev/cli.ts docker-stop",
    "docker:build": "docker compose -p educomply --profile app build backend frontend",
    "docker:logs": "docker compose -p educomply --profile app logs --tail 100 backend frontend",
    "docker:ps": "docker compose -p educomply --profile app ps",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend && tsc -p tools --noEmit",
    "test": "npm run test -w backend && npm run test -w frontend && npm run test:tools",
    "test:tools": "vitest run --config tools/vitest.config.ts",
    "test:db": "npm run test:db -w backend",
    "test:redis": "npm run test:redis -w backend",
    "test:keycloak": "npm run test:keycloak -w backend",
    "test:e2e": "npm run test:e2e -w backend",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "npm run db:generate -w backend",
    "db:validate": "npm run db:validate -w backend",
    "db:status": "npm run db:status -w backend",
    "db:migrate:deploy": "npm run db:migrate:deploy -w backend",
    "db:migrate:create": "npm run db:migrate:create -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:inspect": "npm run db:inspect -w backend",
    "db:grant-role": "npm run db:grant-role -w backend --",
    "db:studio": "npm run db:studio -w backend",
    "redis:up": "docker compose -p educomply up -d redis",
    "redis:down": "docker compose -p educomply stop redis",
    "redis:status": "docker compose -p educomply ps redis",
    "auth:init-env": "npm run auth:init-env -w backend",
    "keycloak:up": "npm run auth:init-env -w backend -- --check && docker compose -p educomply up -d keycloak",
    "keycloak:status": "docker compose -p educomply ps keycloak",
    "keycloak:logs": "docker compose -p educomply logs --tail 50 keycloak",
    "keycloak:reset": "docker compose -p educomply rm -sf keycloak && docker volume rm -f educomply_keycloak-data",
    "kc:user": "npm run kc:user -w backend --"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neondatabase/serverless": "^1.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
