# EduComply environment template
# Copy to `.env` in the repository root and fill in real values locally.
#   Bash:        cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
# Never commit `.env`. Every line must be KEY=value.

# ── Backend: server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origin of the React app (cookies, redirects)
APP_ORIGIN=http://localhost:5173
# Browser origins allowed by CORS, comma-separated, exact match (defaults to APP_ORIGIN)
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database: Neon PostgreSQL ──────────────────────────────────────
# Copy both from Neon console → Connect. Keep channel_binding/sslmode params.
# Pooled connection (host contains "-pooler") for the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/educomply_db?sslmode=require"
# Direct (non-pooled) connection, required by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/educomply_db?sslmode=require"

# ── Redis: temporary state only (sessions, rate limits) ────────────
# Local: `npm run redis:up` (docker compose). Production: managed Redis, rediss://user:pass@host:port
REDIS_URL=redis://localhost:6379
# Namespace for all keys; change per environment if several share one Redis
REDIS_KEY_PREFIX=educomply:

# ── Sessions and OpenID Connect (used from feature/auth-oidc) ──────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback

# ── Frontend (Vite exposes only VITE_* variables to the browser) ───
# Leave as /api/v1 in development; Vite proxies it to the backend.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=EduComply
