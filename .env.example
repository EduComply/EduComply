# EduComply environment template
# Copy to `.env` in the repository root and fill in real values locally.
#   Bash:        cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
# Never commit `.env`. Every line must be KEY=value.

# ── Backend: server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origin of the React app (cookies, redirects)
APP_ORIGIN=http://localhost:5173
# Browser origins allowed by CORS, comma-separated, exact match (defaults to APP_ORIGIN)
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Database: Neon PostgreSQL ──────────────────────────────────────
# Copy both from Neon console → Connect. Keep channel_binding/sslmode params.
# Pooled connection (host contains "-pooler") for the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/educomply_db?sslmode=require"
# Direct (non-pooled) connection, required by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/educomply_db?sslmode=require"
# tcp (default): PostgreSQL protocol on port 5432.
# websocket: Neon serverless driver over HTTPS port 443 (wss://, certificate verified) for
# networks that block 5432. Migrations (DIRECT_URL) still need a network that allows 5432.
DATABASE_TRANSPORT=tcp

# ── Redis: temporary state only (sessions, rate limits) ────────────
# Local: `npm run redis:up` (docker compose). Production: managed Redis, rediss://user:pass@host:port
REDIS_URL=redis://localhost:6379
# Namespace for all keys; change per environment if several share one Redis
REDIS_KEY_PREFIX=educomply:

# ── OpenID Connect (Keycloak in development) ───────────────────────
# Leave these four empty and run `npm run auth:init-env`: it fills them (and the Keycloak
# admin credentials below) with local development values and random secrets.
# All four must be set together; production requires https URLs.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Keycloak (via the Vite proxy in development)
OIDC_REDIRECT_URI=
# Optional: where Keycloak returns after single logout (default APP_ORIGIN + "/")
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# OIDC_SCOPES=openid email profile
# Optional back-channel URL when the backend cannot reach OIDC_ISSUER's host. Not needed for
# `npm run dev`; docker-compose.yml sets http://keycloak:8080 for the containerised backend.
# OIDC_INTERNAL_URL=

# ── Keycloak bootstrap admin (docker compose + npm run kc:user only) ─
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# ── Frontend (Vite exposes only VITE_* variables to the browser) ───
# Leave as /api/v1 in development; Vite proxies it to the backend.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=EduComply
