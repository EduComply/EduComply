# Build context is the repository root (npm workspaces share one lockfile).
# Secrets never enter an image: runtime configuration comes from docker-compose.yml.
.env
.env.*
!.env.example
**/*.pem
**/*.key
secrets/

# Version control, editors, local tooling state
.git
.github
.vscode
.idea
.dev
.claude

# Dependencies and build output are rebuilt inside the image
**/node_modules
**/dist
backend/src/generated
**/coverage
**/*.log
**/*.tsbuildinfo
