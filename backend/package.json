{
  "name": "@educomply/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run db:generate && tsx watch --clear-screen=false src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "npm run db:generate && vitest run",
    "test:watch": "vitest",
    "test:db": "npm run db:generate && vitest run --config vitest.db.config.ts",
    "test:redis": "vitest run --config vitest.redis.config.ts",
    "test:keycloak": "npm run db:generate && vitest run --config vitest.keycloak.config.ts",
    "test:e2e": "npm run db:generate && vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate --no-hints",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:seed": "npm run db:generate && prisma db seed",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "db:grant-role": "npm run db:generate && tsx scripts/grant-role.ts",
    "db:studio": "prisma studio",
    "auth:init-env": "tsx scripts/init-auth-env.ts",
    "kc:user": "tsx scripts/keycloak-user.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
