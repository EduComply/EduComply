// EduComply — Sprint 1 schema: identity, roles and audit.
// Source of truth: EduComply ER Diagram ("User & Authentication"),
// Initial API Design v0.1 §4 (roles) and §9 (audit), Proposal v1.1 §11.
// Later-sprint entities (Course, Enrollment, Video, …) are added in their sprints.
//
// Connection URLs are configured in prisma.config.ts (CLI, direct) and
// src/shared/infrastructure/database/prisma.ts (runtime, pooled).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// ER: USER.user_type
enum UserType {
  STUDENT
  STAFF

  @@map("user_type")
}

/// ER: USER_IDENTITY.protocol — OIDC now, SAML 2.0 (incl. Shibboleth) later.
enum AuthProtocol {
  OIDC
  SAML

  @@map("auth_protocol")
}

/// ER: ROLE. Seeded values: LEARNER, ADMIN, REVIEWER (API Design §4).
model Role {
  id          Int     @id @default(autoincrement()) @db.SmallInt
  name        String  @unique @db.VarChar(30)
  description String?

  users User[]

  @@map("role")
}

/// ER: USER. One role per user ("assigned to": ROLE 1 — USER 0..N).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  roleId          Int       @map("role_id") @db.SmallInt
  email           String    @unique @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(150)
  institutionalId String?   @unique @map("institutional_id") @db.VarChar(50)
  userType        UserType  @map("user_type")
  department      String?   @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role        Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  identities  UserIdentity[]
  auditEvents AuditEvent[]   @relation("AuditActor")

  @@index([roleId])
  @@map("user")
}

/// ER: USER_IDENTITY. A user "authenticates via" 1..N institutional identities.
/// (issuer, subject) uniquely identifies an external account.
model UserIdentity {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  protocol   AuthProtocol
  issuer     String       @db.VarChar(255)
  subject    String       @db.VarChar(255)
  linkedAt   DateTime     @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identity")
}

/// Append-only audit record (Proposal §11, API Design §9): actor, action,
/// target, reason, request id and hashed IP. Not in the ER core diagram.
/// UPDATE and DELETE are blocked by a database trigger (see migration).
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.VarChar(100)
  reason     String?
  metadata   Json?    @db.JsonB
  requestId  String?  @map("request_id") @db.VarChar(100)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt])
  @@index([targetType, targetId])
  @@index([action, occurredAt])
  @@index([occurredAt])
  @@map("audit_event")
}
